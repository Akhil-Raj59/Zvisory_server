# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/zvisory?retryWrites=true&w=majority

# Server Port & Frontend Origin
PORT=5000
FRONTEND_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_hex_string
JWT_EXPIRY=7d

# Media Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_NAME="Zvisory Real Estate Advisory"
SMTP_FROM_EMAIL=no-reply@example.com

# Lead Module Email Recipients
COMPANY_DOMAIN=zvisory.com
CONTACT_US_EMAIL=contactus@example.com
MARKETING_TEAM_EMAIL=marketing@example.com
LEAD_NOTIFICATION_FROM_EMAIL=no-reply@example.com

# LeadSquared CRM Integration (Backend-only secrets)
LEADSQUARED_API_URL=https://your-leadsquared-api-url
LEADSQUARED_API_KEY=your_leadsquared_api_key
LEADSQUARED_API_SECRET=your_leadsquared_api_secret

# Cloudflare Turnstile Spam Protection (Backend secret key)
TURNSTILE_SECRET_KEY=your_cloudflare_secret_key

# Outbox Background Job Configuration
OUTBOX_POLL_INTERVAL_MS=15000
OUTBOX_MAX_RETRIES=5

site -"0x4AAAAAAF14Y4JyMjiRvZaN"
sectet - "0x4AAAAAAF14YyL8OZGOsu-iENWNU0o3oyc"